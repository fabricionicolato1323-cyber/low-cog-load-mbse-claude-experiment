{
  "name": "lcl-mbse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "adapters/*",
    "spikes/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "arch": "depcruise packages adapters --config .dependency-cruiser.cjs",
    "contracts": "tsx tools/contracts-gen.ts",
    "contracts:check": "tsx tools/contracts-gen.ts --check",
    "test": "vitest run",
    "test:fast": "npm run typecheck && npm run lint && npm run arch && npm run contracts:check && npm run test",
    "test:linux": "node scripts/test-linux.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
